# Rendered into kitty/emoji.conf by home-manager (nix/homeModules/home/legacy.nix) or install.pl.
# @emoji_font@ is the platform's native colour emoji font: Apple Color Emoji on macOS, where CoreText
# can't load Noto's CBDT bitmaps, and Noto Color Emoji elsewhere. Symbola is installed via home-manager
# (nix/homeModules/home/default.nix).
# BMP ranges are limited to Emoji_Presentation=Yes codepoints so text-style symbols and
# the Nerd Font ranges above are left alone.
# Watch, hourglass, media controls
symbol_map U+231A-U+231B,U+23E9-U+23F3 @emoji_font@
# Text-presentation emoji (eg pause, heavy check mark, scissors, snowflake, sun, smiley,
# gear). Apps (eg Claude Code) emit these bare, one cell wide, and a colour bitmap forced
# into one cell renders as a clipped sliver or blank, so use a monochrome font. This also
# makes the VS16 form monochrome. Covers U+23F8-U+23FA, the rest of Dingbats and the
# text-style Emoji=Yes symbols in Miscellaneous Symbols, minus the codepoints below that
# are deliberately colour and the Nerd Font ranges above.
symbol_map U+23F8-U+23FA,U+2600-U+2604,U+260E,U+2611,U+2618,U+261D,U+2620,U+2622-U+2623,U+2626,U+262A,U+262E-U+262F,U+2638-U+263A,U+2640,U+2642,U+265F-U+2660,U+2663,U+2666,U+2668,U+267B,U+267E,U+2692,U+2694-U+2697,U+2699,U+269B-U+269C,U+26A0,U+26A7,U+26B0-U+26B1,U+26C8,U+26CF,U+26D1,U+26D3,U+26E9,U+26F0-U+26F1,U+26F4,U+26F7-U+26F9 Symbola
symbol_map U+2700-U+2704,U+2706-U+2709,U+270C-U+2727,U+2729-U+274B,U+274D,U+274F-U+2752,U+2756,U+2758-U+276B,U+2772-U+2775,U+2794,U+2798-U+27AF,U+27B1-U+27BE Symbola
# Geometric shapes, weather, zodiac, misc symbols
symbol_map U+25FD-U+25FE,U+2614-U+2615,U+2648-U+2653,U+267F,U+2693,U+26AA-U+26AB,U+26BD-U+26BE,U+26C4-U+26C5,U+26CE,U+26D4,U+26EA,U+26F2-U+26F3,U+26F5,U+26FA,U+26FD @emoji_font@
# Dingbats, supplemental arrows/shapes
symbol_map U+2705,U+270A-U+270B,U+2728,U+274C,U+274E,U+2753-U+2755,U+2757,U+2795-U+2797,U+27B0,U+27BF,U+2B1B-U+2B1C,U+2B50,U+2B55 @emoji_font@
# Mahjong, playing cards, enclosed alphanumerics/ideographic supplement
symbol_map U+1F004,U+1F0CF,U+1F170-U+1F171,U+1F17E-U+1F17F,U+1F18E,U+1F191-U+1F19A,U+1F201-U+1F202,U+1F21A,U+1F22F,U+1F232-U+1F23A,U+1F250-U+1F251 @emoji_font@
# Regional indicators (flags)
symbol_map U+1F1E6-U+1F1FF @emoji_font@
# Misc Symbols and Pictographs, Emoticons
symbol_map U+1F300-U+1F64F @emoji_font@
# Transport and Map Symbols
symbol_map U+1F680-U+1F6FF @emoji_font@
# Supplemental Symbols and Pictographs
symbol_map U+1F900-U+1F9FF @emoji_font@
# Symbols and Pictographs Extended-A
symbol_map U+1FA70-U+1FAFF @emoji_font@
